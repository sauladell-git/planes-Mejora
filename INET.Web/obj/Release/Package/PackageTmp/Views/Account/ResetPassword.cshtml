@model INET.Services.DTO.ResetPasswordModel
@{
    ViewBag.Title = "Recuperar contraseña";    
}

@section scripts {
    @Scripts.Render("~/bundles/jqueryval")
    @Scripts.Render("~/scripts/js/resetPassword.js?v" + INET.Web.ApplicationInformation.ExecutingAssemblyVersion)
}

<div id="msg-reset-password" class="message-wrapper"></div>
<div class="login">
    @using (Html.BeginForm("ResetPassword", "Account", FormMethod.Post)) {
        @Html.AntiForgeryToken()    
        <h2>Cambiar contraseña</h2>
        
        @Html.Label("Nueva contraseña:", new { @class = "label" })        
        @Html.PasswordFor(x => x.NewPassword, new { @class = "input" })
        
        @Html.Label("Repetir nueva contraseña:", new { @class = "label" })        
        @Html.PasswordFor(x => x.ConfirmPassword, new { @class = "input" })                
        
        <input type="submit" value="Modificar clave" class="btn" />
        <a href="@Url.Action("Login", "Account")"><p class="btn-sm">Volver</p></a>
        
        @Html.HiddenFor(x => x.UserName)
        @Html.HiddenFor(x => x.Token)
    }
</div>

@Html.Partial("_MessageResult")