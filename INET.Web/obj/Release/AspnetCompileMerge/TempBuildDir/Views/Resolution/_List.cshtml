@model List<INET.Data.Resolution>

@using INET.Core.Constants
@using INET.Utils.Helpers

<div class="table-float">
    <h1>Disposiciones</h1>
    <div id="msg-resolutions"></div>
    @if (SessionHelper.HasPermission(PermissionConstants.Resolutions.CREATE))
    {
        <div class="nuevo-resolucion" id="nuevo-resolucion">Nueva Disposición</div>
    }
    <table cellpadding="0" cellspacing="1" class="list" id="list-documents">
        <thead>
            <tr>
                <td width="110px" valign="middle">Acciones</td>
                <td>ID</td>
                <td>Número Disposición</td>
                <td>Dictámenes</td>
                <td>Fecha Generación</td>
                <td>Creado Por</td>
                <td>Planes De Mejora</td>
                <td>Estado</td>
                <td>Monto Ejecutado</td>
            </tr>
        </thead>
        <tbody></tbody>
        <tfoot>
            <tr></tr>
        </tfoot>
    </table>
</div>
