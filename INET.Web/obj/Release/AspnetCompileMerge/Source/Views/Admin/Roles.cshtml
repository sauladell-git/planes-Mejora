@model INET.Services.DTO.RoleDTO
@{
    ViewBag.Title = "Roles";
}

@Html.Partial("_MenuAdmin")

<div class="table-float">
    <div id="msg-list-roles"></div>
    <table cellpadding="0" cellspacing="1" class="list" id="list">
        <thead>
            <tr>
                <td width="90px" valign="middle">Acciones</td>
                <td>Rol de usuario</td>
            </tr>
        </thead>
        <tbody>
            @foreach (var role in Model.Roles)
            {
            <tr data-templateId="@role.RoleId">
                <td align="center" class="actions">
                    <a href="@Url.Action("RoleEditor", "Admin", new { id = role.RoleId } )"><img src="~/Img/icons/icon-edit.png" title="Editar"></a>
                </td>
                <td>@role.RoleName</td>
            </tr>
            }
        </tbody>
        <tfoot>
            <tr></tr>
        </tfoot>
    </table>
</div>

@section scripts {
    @Scripts.Render("~/bundles/jqueryval")
    @Scripts.Render("~/scripts/js/roles.js?v" + INET.Web.ApplicationInformation.ExecutingAssemblyVersion)
}

@Html.Partial("_MessageResult")