@{
    ViewBag.Title = "Recuperar contraseña";    
}

@section scripts {
    @Scripts.Render("~/bundles/jqueryval")
    @Scripts.Render("~/scripts/js/forgotPassword.js?v" + INET.Web.ApplicationInformation.ExecutingAssemblyVersion)
}

<div id="msg-forgot-password" class="message-wrapper"></div>
<div class="login">
    @using (Html.BeginForm("ForgotPassword", "Account", FormMethod.Post)){
        <label class="label">Usuario:</label>
        <input type="text" id="userName" name="userName" class="input" required="required"/>
        <input type="submit" value="Recuperar clave" class="btn" />
        <a href="@Url.Action("Login", "Account")" class="btn btn-sm">Volver</a>
    }
</div>
@Html.Partial("_MessageResult")