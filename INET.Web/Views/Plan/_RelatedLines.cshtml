@model IList<INET.Data.RelatedLines_22>
@using INET.Data
@using INET.Core.Enums
@using INET.Utils.Helpers



    <div>
       

    </div>


<table cellpadding="0" cellspacing="1" class="list" id="related-lines">
    <thead>
        <tr>
            <td width="110px">Planes Vinculados</td>
            <td>Linea(214/22) </td>

        </tr>
    </thead>
    <tbody>
        @foreach (var line in Model.OrderByDescending(x => x.Id).ToList())
        {
       
            <tr data-relatedlineId="@line.Id" >
                <td width="50px" align="center" class="actions">
                    <a href="~/detalle-del-plan?id=@line.ImprovementPlanId_Link" target="_blank"> ver</a>
                    @*<img src="~/Img/icons/icon-delete.png" class="related-lines-action-delete actionLink"  title="Eliminar" />*@
                </td>
           

                <td> @line.Lines_22.Description</td>
               
            </tr>
        }
    </tbody>
    <tfoot>
        <tr></tr>
    </tfoot>
</table>

