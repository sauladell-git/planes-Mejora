@model List<INET.Services.DTO.AccountRenderingViewDTO>
@using INET.Data
@using INET.Core.Enums
@using INET.Utils.Helpers
@using INET.Services
@using INET.Core.Constants

<table cellpadding="0" cellspacing="1" class="list2" id="list-accounts">
    <thead>
        <tr>
            <td width="110px">Acciones</td>

            <td width="50px">Id Rendicion</td>
            <td width="50px">Dictamen</td>

            <td width="80px">Objeto Gasto</td>
            <td width="50px">Fecha</td>
            <td width="50px">Monto Aprobado Rendicion</td>
            <td width="50px">Monto Rendicion Rechazado</td>
            <td width="50px">Comentarios</td>
        </tr>
    </thead>
    <tbody>
        @foreach (var account in Model)
        {
            var cssClass = "gradeU";

            <tr value="@account.AccountingRenderingID" data-rendicionId="@account.AccountingRenderingID" data-improvementPlanId="@account.ImprovementPlanId" class="@cssClass">
                @*<td width="110px" align="center" class="actions">*@
                @*<img src="~/Img/icons/icon-delete.png" class="account-action-delete actionLink" title="Eliminar" />*@

                @*</td>*@
                <td width="50px">
                    <img src="~/Img/icons/icon-edit.png" class="account-action-edit actionLink" title=@account.AccountingRenderingID.ToString() />
                    @if (SessionHelper.HasAnyRole(new string[] {RoleConstants.ADMIN }))
                    {
                        <img src="~/Img/icons/icon-delete.png" data-AccountRenderingId="@account.AccountingRenderingID" class="account-action-delete actionLink" title=@account.AccountingRenderingID.ToString() />
                    }


                </td>
                <td width="50px">@account.Number.ToString()</td>


                <td width="50px">@account.DictumNumber</td>

                <td width="80px">@account.ExpenditureObjectType</td>
                <td width="50px">@account.Date.ToString("dd/MM/yyyy")</td>
                <td width="50px">@account.AprovedAmount.ToString("#.00")</td>
                <td width="50px">@account.RejectedAmount.ToString("#.00")</td>
                <td width="50px">@account.Comments</td>
            </tr>
        }
    </tbody>
    <tfoot>
        <tr></tr>
    </tfoot>
</table>