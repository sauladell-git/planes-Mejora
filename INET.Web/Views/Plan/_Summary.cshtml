@model List<INET.Data.Solicitude>
@using INET.Core.Enums
@using INET.Core.Constants
@using INET.Utils.Helpers

@{
    var solicitudesByLine = Model.GroupBy(x => x.LineId).ToList();
    var solicitudesByCUE = Model.GroupBy(x => x.CUE).ToList();
    var showSolicitudesByCUE = (Model.FirstOrDefault() != null)
                        ? Model.First().ImprovementPlan.ImprovementPlanTypeId == ImprovementPlanTypeEnum.Jurisdiccional.ToInt()
                        : false;
    var solicitudesByExpendType = Model.GroupBy(x => x.ExpenditureTypeId).ToList();
    var solicitudesByExpendObject =  Model.GroupBy(x => x.ExpenditureObjectType).ToList();

}



@if(showSolicitudesByCUE) 
{
    <p class="celeste">CUE:</p>
    <table cellpadding="0" cellspacing="1" class="list2" id="summary-table-cue">
        <thead>
            <tr>
                <td>CUE</td>
                <td>Línea</td>                
                <td>Expediente</td>
                <td>Monto</td>
            </tr>
        </thead>
        <tbody>            
            @foreach (var sbc in solicitudesByCUE)
            {                
                // Verifico si para el CUE actual hay al menos un solicitado habilitado
                var validCUE = sbc.Where(x => x.StatusId != SolicitudeStatusEnum.Anulado.ToInt()).Any();
                if (validCUE)
                {                
                    // Calculo el total por línea excluyendo los solicitados anulados
                    decimal totalByCUE = 0;
                    foreach (var s in sbc) {
                        if (s.StatusId != SolicitudeStatusEnum.Anulado.ToInt())
                        {
                            totalByCUE += s.RequestedTotal;
                        }
                    }

                    var solicitude = sbc.Where(x => x.StatusId != SolicitudeStatusEnum.Anulado.ToInt()).First();                                
                    <tr>
                        <td>@solicitude.CUE</td>                        
                        <td>@(solicitude.LineId.HasValue ? @solicitude.Line.Description : "- sin línea asignada -")</td>
                        <td>@solicitude.FileNumber</td>
                        <td align="center">@totalByCUE.ToString("C")</td>
                    </tr>
                }
            }
        </tbody>
        <tfoot>
            <tr></tr>
        </tfoot>
    </table>
}

<p class="celeste">Líneas:</p>

<form id="frmFileNumbers">
    <table cellpadding="0" cellspacing="1" class="list2" id="summary-table">
        <thead>
            <tr>
                <td>Línea</td>
                <td>Expediente</td>
                <td>Monto</td>
            </tr>
        </thead>
        <tbody>
            @foreach (var sbl in solicitudesByLine)
            {
                // Verifico si para la línea actual hay al menos un solicitado habilitado
                var validLine = sbl.Where(x => x.StatusId != SolicitudeStatusEnum.Anulado.ToInt()).Any();
                if (validLine)
                {
                    // Calculo el total por línea excluyendo los solicitados anulados
                    decimal totalByLine = 0;
                    foreach (var s in sbl)
                    {
                        if (s.StatusId != SolicitudeStatusEnum.Anulado.ToInt())
                        {
                            totalByLine += s.RequestedTotal;
                        }
                    }

                    var solicitude = sbl.Where(x => x.StatusId != SolicitudeStatusEnum.Anulado.ToInt()).First();

                    <tr data-lineId="@sbl.Key">
                        <td>@(solicitude.LineId.HasValue ? @solicitude.Line.Description : "- sin línea asignada -")</td>
                        <td class="file-number-field">
                            @if (SessionHelper.HasPermission(PermissionConstants.Solicitudes.FILE_NUMBER) && solicitude.ImprovementPlan.StatusId == (int)StageStatusEnum.EnEvaluacion)
                            {
                                @Html.TextBox("file-number-for-LineId-" + sbl.Key, solicitude.FileNumber, new { @class = "fileNumber", required = "required" })
                            }
                            else
                            {
                                @solicitude.FileNumber
                            }
                        </td>
                        <td align="center">@totalByLine.ToString("C")</td>
                    </tr>
                }
            }
        </tbody>
        <tfoot>
            <tr></tr>
        </tfoot>
    </table>
    
            <p class="celeste">Gastos:</p>
            <table cellpadding="0" cellspacing="1" class="list2" id="summary-table">
                <thead>
                    <tr>
                        <td>Tipo</td>

                        <td>Monto</td>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var sbl in solicitudesByExpendType)
                    {
                        // Verifico si para la línea actual hay al menos un solicitado habilitado
                        var validLine = sbl.Where(x => x.StatusId != SolicitudeStatusEnum.Anulado.ToInt()).Any();
                        if (validLine)
                        {
                            // Calculo el total por línea excluyendo los solicitados anulados
                            decimal totalByLine = 0;
                            foreach (var s in sbl)
                            {
                                if (s.StatusId != SolicitudeStatusEnum.Anulado.ToInt())
                                {
                                    totalByLine += s.RequestedTotal;
                                }
                            }

                            var solicitude = sbl.Where(x => x.StatusId != SolicitudeStatusEnum.Anulado.ToInt()).First();

                            <tr data-lineId="@sbl.Key">
                                <td>@(solicitude.ExpenditureObjectTypeId.HasValue ? @solicitude.ExpenditureType.Description : "- sin gasto asignado -")</td>
                                <td align="center">@totalByLine.ToString("C")</td>
                            </tr>
                        }
                    }
                </tbody>
                <tfoot>
                    <tr></tr>
                </tfoot>
            </table>
        
            <p class="celeste">Detalle Gastos:</p>
            <table cellpadding="0" cellspacing="1" class="list2" id="summary-table">
                <thead>
                    <tr>
                        <td>Objeto</td>

                        <td>Monto</td>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var sbl in solicitudesByExpendObject)
                    {
                        // Verifico si para la línea actual hay al menos un solicitado habilitado
                        var validLine = sbl.Where(x => x.StatusId != SolicitudeStatusEnum.Anulado.ToInt()).Any();
                        if (validLine)
                        {
                            // Calculo el total por línea excluyendo los solicitados anulados
                            decimal totalByLine = 0;
                            foreach (var s in sbl)
                            {
                                if (s.StatusId != SolicitudeStatusEnum.Anulado.ToInt())
                                {
                                    totalByLine += s.RequestedTotal;
                                }
                            }

                            var solicitude = sbl.Where(x => x.StatusId != SolicitudeStatusEnum.Anulado.ToInt()).First();

                            <tr data-lineId="@sbl.Key">
                                <td>@(solicitude.ExpenditureObjectTypeId.HasValue ? @solicitude.ExpenditureObjectType.Description : "- sin  objeto gasto asignado -")</td>
                                <td align="center">@totalByLine.ToString("C")</td>
                            </tr>
                        }
                    }
                </tbody>
                <tfoot>
                    <tr></tr>
                </tfoot>
            </table>
      


    

    <div id="file-numbers-hiddens"></div>
</form>


