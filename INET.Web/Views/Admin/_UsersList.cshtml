@model List<INET.Data.UserProfile>
<div class="table-float">
    <div id="msg-list-users"></div>
    <div class="nuevo-usuario" id="nuevo-usuario">Nuevo usuario</div>
    <table cellpadding="0" cellspacing="1" class="list" id="list">
        <thead>
            <tr>
                <td width="90px" valign="middle">Acciones</td>
                <td>ID</td>
                <td width="170px">Nombre de Usuario</td>
                <td>Apellido</td>
                <td>Nombre</td>
                <td>Rol</td>
                <td>Provincia</td>
                <td>Habilitado</td>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model)
            {
                var roleName = @user.webpages_Roles.First().RoleName;
                var provinces = user.Provinces.Aggregate("", (c, t) => c + (String.IsNullOrEmpty(c) || String.IsNullOrEmpty(t.Name) ? "" : ", ") + t.Name);
            <tr data-userId="@user.UserId" data-userName="@user.UserName" data-name="@user.Name" data-lastName="@user.LastName" data-role="@roleName" data-provincesIds="@user.Provinces.Aggregate("", (c, t) => c + (String.IsNullOrEmpty(c) ? "" : ",") + t.Id.ToString())" data-isEnabled="@user.IsEnabled" data-fieldsIds="@user.Fields.Aggregate("", (c, t) => c + (String.IsNullOrEmpty(c) ? "" : ",") + t.Id.ToString())" data-levelsIds="@user.InstitutionLevels.Aggregate("", (c, t) => c + (String.IsNullOrEmpty(c) ? "" : ",") + t.Id.ToString())">
                <td align="center" class="actions"><img src="~/img/icons/icon-edit.png" title="Editar" class="edit-user"><img src="~/img/icons/icon-delete.png" title="Eliminar" class="delete"></td>
                <td>@user.UserId</td>
                <td>@user.UserName</td>
                <td>@user.LastName</td>
                <td>@user.Name</td>
                <td>@roleName</td>
                <td>@(!provinces.IsEmpty() ? provinces : "-sin provincias-")</td>
                <td align="center">@user.EnabledToString</td>
            </tr>
            }
        </tbody>
        <tfoot>
            <tr></tr>
        </tfoot>
    </table>
</div>