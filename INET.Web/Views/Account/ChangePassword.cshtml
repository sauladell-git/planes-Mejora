@model INET.Services.DTO.LocalPasswordModel
@{
    ViewBag.Title = "Cambiar contraseña";    
}

@section scripts {  
    @Scripts.Render("~/bundles/jqueryval")
    @Scripts.Render("~/scripts/js/changePassword.js?v" + INET.Web.ApplicationInformation.ExecutingAssemblyVersion)
}

<div id="msg-password" class="message-wrapper"></div>
<div class="login">
    @using (Html.BeginForm("ChangePassword", "Account", FormMethod.Post, new { id = "frmChangePassword" })) {    
        @Html.AntiForgeryToken()
        <h2>Cambiar contraseña</h2>        
        @Html.Label("Contraseña actual:", new { @class = "label" })
        @Html.PasswordFor(x => x.OldPassword, new { @class = "input" })                
        
        @Html.Label("Nueva contraseña:", new { @class = "label" })        
        @Html.PasswordFor(x => x.NewPassword, new { @class = "input" })
        
        @Html.Label("Repetir nueva contraseña:", new { @class = "label" })        
        @Html.PasswordFor(x => x.ConfirmPassword, new { @class = "input" })                
        
        <input type="submit" value="Modificar clave" class="btn" />
        <a href="@Url.Action("Index", "Home")"><p class="btn-sm">Volver</p></a>
    }
</div>

@Html.Partial("_MessageResult")