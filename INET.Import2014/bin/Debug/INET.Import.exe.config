<?xml version="1.0" encoding="utf-8"?>
<configuration>  
  <configSections>    
    <section name="entityFramework" type="System.Data.Entity.Internal.ConfigFile.EntityFrameworkSection, EntityFramework, Version=6.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
    <section name="log4net" type="log4net.Config.Log4NetConfigurationSectionHandler, log4net" requirePermission="false" />
  <!-- For more information on Entity Framework configuration, visit http://go.microsoft.com/fwlink/?LinkID=237468 --></configSections>
  <connectionStrings>
    <add name="INETContext" connectionString="metadata=res://*/INET.csdl|res://*/INET.ssdl|res://*/INET.msl;provider=System.Data.SqlClient;provider connection string=&quot;Server=(localdb)\MSSQLLocalDB;Initial Catalog=INET_TEST_V7;integrated security=True;multipleactiveresultsets=True;application name=EntityFramework&quot;" providerName="System.Data.EntityClient" />
  </connectionStrings>
  <appSettings>
    <add key="InputFolderPath" value="C:\Users\San\Desktop\Test" />
  </appSettings>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.0" />
  </startup>
  <entityFramework>
    <defaultConnectionFactory type="System.Data.Entity.Infrastructure.LocalDbConnectionFactory, EntityFramework">
      <parameters>
        <parameter value="v11.0" />
      </parameters>
    </defaultConnectionFactory>
    <providers>
      <provider invariantName="System.Data.SqlClient" type="System.Data.Entity.SqlServer.SqlProviderServices, EntityFramework.SqlServer" />
    </providers>
  </entityFramework>

  <log4net>
    <appender name="LogToImportFile" type="log4net.Appender.FileAppender">
      <file value="C:\Projects\WebQ\INET\INET\INET.Import\Logs\Import.log" />
      <appendToFile value="true" />
      <layout type="log4net.Layout.PatternLayout">
        <conversionPattern value="%date [%thread] %level - %message%newline" />
      </layout>
    </appender>
    <appender name="LogEvaluatorsToFile" type="log4net.Appender.FileAppender">
      <file value="C:\Projects\WebQ\INET\INET\INET.Import\Logs\Evaluators.log" />
      <appendToFile value="true" />
      <layout type="log4net.Layout.PatternLayout">
        <conversionPattern value="%date - %level - %message%newline" />
      </layout>
    </appender>   
    <!--<logger name="NHibernate.SQL"> -->
    <!-- Value of priority may be ALL, DEBUG, INFO, WARN, ERROR, FATAL, OFF -->
    <!--
        <priority value="ALL"/>
        <appender-ref ref="LogToFile"/>
      </logger>-->
    <root>
      <level value="ALL" />
      <appender-ref ref="LogToImportFile" />      
    </root>
    
    <logger additivity="false" name="LogEvaluatorsToFile">
      <level value="DEBUG" />
      <appender-ref ref="LogEvaluatorsToFile" />
    </logger>    
  </log4net>
  
</configuration>
