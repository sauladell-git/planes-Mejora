    <Property Name="EntityId" Type="Int32" Nullable="false" />
    <Property Name="EntityName" Type="String" Nullable="false" MaxLength="50" Unicode="true" FixedLength="false" />
    <Property Name="PropertyName" Type="String" Nullable="false" MaxLength="50" Unicode="true" FixedLength="false" />
    <Property Name="AdditionalData" Type="String" MaxLength="50" Unicode="true" FixedLength="false" />
    <Property Name="Action" Type="String" Nullable="false" MaxLength="50" Unicode="true" FixedLength="false" />
    <Property Name="TimeStamp" Type="DateTime" Nullable="false" Precision="3" />
    <Property Name="OriginalValue" Type="String" MaxLength="500" Unicode="true" FixedLength="false" />
    <Property Name="CurrentValue" Type="String" MaxLength="500" Unicode="true" FixedLength="false" />
    <NavigationProperty Name="UserProfile" Relationship="INET.Data.FK_Audits_UserProfile" FromRole="Audits" ToRole="UserProfile" />
